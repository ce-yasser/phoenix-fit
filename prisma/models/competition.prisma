model Competition {
  id            String    @id @default(ulid())
  competition   String
  userId        Int
  user          User      @relation(fields: [userId], references: [id])
  data          Json
  status        RegistrationStatus    @default(PENDING)
  submittedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}
